# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/student_workload

# Secret used to sign login tokens (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional: time zone used by the database session (defaults to the server's local zone)
# DB_TIMEZONE=Asia/Kolkata
